#!/bin/sh
set -eu
cd "$(dirname "$0")"
if [ -f gradle/wrapper/gradle-wrapper.jar ]; then
  exec java -classpath gradle/wrapper/gradle-wrapper.jar org.gradle.wrapper.GradleWrapperMain "$@"
fi
if command -v gradle >/dev/null 2>&1; then
  echo "AVISO: wrapper JAR ausente, usando Gradle instalado. Execute 'gradle wrapper --gradle-version 8.14.3' para completar o Wrapper." >&2
  exec gradle "$@"
fi
echo "Gradle Wrapper incompleto: falta gradle/wrapper/gradle-wrapper.jar. Instale o Gradle e execute: gradle wrapper --gradle-version 8.14.3" >&2
exit 1
